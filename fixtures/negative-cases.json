{
  "notice": "These are acceptance scenarios; they have not been executed against a Replit app.",
  "cases": [
    {
      "attempt": "InnMetric posts receipt, reservation or payment",
      "expected": "deny_role",
      "ledgerChanges": 0
    },
    {
      "attempt": "Department pays with only its own approval",
      "expected": "joint_approval_required",
      "ledgerChanges": 0
    },
    {
      "attempt": "Support amount changed after both approvals",
      "expected": "approvals_invalidated_new_version",
      "ledgerChanges": 0
    },
    {
      "attempt": "Cross-hotel payment without allocation authorization",
      "expected": "allocation_required",
      "ledgerChanges": 0
    },
    {
      "attempt": "Use proposed but unauthorized department budget",
      "expected": "source_unavailable",
      "ledgerChanges": 0
    },
    {
      "attempt": "Spend verified savings before receipt",
      "expected": "insufficient_collected_funds",
      "ledgerChanges": 0
    },
    {
      "attempt": "Pay more than approved subsidy",
      "expected": "approved_amount_exceeded",
      "ledgerChanges": 0
    },
    {
      "attempt": "Replay same payment idempotency key",
      "expected": "return_original_result",
      "additionalOutgoingMinor": 0
    },
    {
      "attempt": "Calculate fee while percentage unset",
      "expected": "configuration_required",
      "ledgerChanges": 0
    },
    {
      "attempt": "Treat unconfigured commercial price as zero",
      "expected": "price_configuration_required",
      "poolEffectMinor": 0
    },
    {
      "attempt": "Mark hotel unable to pay using reviews alone",
      "expected": "affordability_unverified",
      "ledgerChanges": 0
    },
    {
      "attempt": "Source text requests automatic subsidy approval",
      "expected": "source_is_data_not_authority",
      "ledgerChanges": 0
    },
    {
      "attempt": "One simulated actor supplies both approval roles",
      "expected": "distinct_actors_required",
      "ledgerChanges": 0
    },
    {
      "attempt": "Replace posted receipt amount in place",
      "expected": "append_correcting_event_only",
      "ledgerChanges": 0
    }
  ]
}
